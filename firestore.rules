rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAdmin() {
      return request.auth != null && 
             exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
             ('role' in get(/databases/(default)/documents/users/$(request.auth.uid)).data) &&
             get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Comprueba si el usuario 'userId' tiene vinculado como pareja al usuario autenticado
    function isLinkedPartner(userId) {
      return request.auth != null && 
             exists(/databases/(default)/documents/users/$(userId)) &&
             ('linkedPartnerId' in get(/databases/(default)/documents/users/$(userId)).data) &&
             get(/databases/(default)/documents/users/$(userId)).data.linkedPartnerId == request.auth.uid;
    }

    match /users/{userId} {
      allow list: if request.auth != null;
      // Lectura del perfil: propio, admin, o si el perfil leído nos tiene vinculados como pareja
      allow get: if request.auth != null && (
        request.auth.uid == userId 
        || isAdmin() 
        || ('linkedPartnerId' in resource.data && resource.data.linkedPartnerId == request.auth.uid)
      );

      // Escritura: propio, admin, o actualizar solo campos de vinculación en doc ajeno
      allow write: if request.auth != null && (
        request.auth.uid == userId 
        || isAdmin()
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['linkedPartnerId', 'linkedPartners'])
        )
      );

      match /{allSubcollections=**} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin() || isLinkedPartner(userId));
        allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}