rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAdmin() {
      return request.auth != null && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isLinkedPartner(userId) {
      return request.auth != null && (
        get(/databases/$(database)/documents/users/$(userId)).data.get('linkedPartnerId', '') == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('linkedPartnerId', '') == userId
      );
    }

    match /users/{userId} {
      // Lectura completa: propio, admin, o pareja vinculada
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin() || isLinkedPartner(userId));

      // Escritura: propio, admin, o actualizar solo campos de vinculación en doc ajeno
      allow write: if request.auth != null && (
        request.auth.uid == userId 
        || isAdmin()
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['linkedPartnerId', 'linkedPartners'])
        )
      );

      match /{allSubcollections=**} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin() || isLinkedPartner(userId));
        allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }
    }

    // Permitir a cualquier usuario autenticado hacer LIST sobre /users para buscar por linkCode
    match /users/{userId} {
      allow list: if request.auth != null;
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}