rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAdmin() {
      return request.auth != null && 
             exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
             ('role' in get(/databases/(default)/documents/users/$(request.auth.uid)).data) &&
             get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Comprueba si el usuario autenticado tiene a 'userId' como su pareja vinculada en su perfil
    function isLinkedPartner(userId) {
      return request.auth != null && 
             exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
             ('linkedPartnerId' in get(/databases/(default)/documents/users/$(request.auth.uid)).data) &&
             get(/databases/(default)/documents/users/$(request.auth.uid)).data.linkedPartnerId == userId;
    }

    match /users/{userId} {
      // Permitir leer cualquier perfil a usuarios autenticados (información básica no sensible: nombre, foto, rol)
      allow get, list: if request.auth != null;

      // Escritura: propio, admin, o actualizar solo campos de vinculación en doc ajeno
      allow write: if request.auth != null && (
        request.auth.uid == userId 
        || isAdmin()
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['linkedPartnerId', 'linkedPartners'])
        )
      );

      // Subcolecciones (Bitácoras diarias, retos, notificaciones): solo accesible por el propio usuario, admin o su pareja vinculada
      match /{allSubcollections=**} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin() || isLinkedPartner(userId));
        allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}