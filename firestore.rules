rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAdmin() {
      return request.auth != null && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin';
    }

    function isLinkedPartner(userId) {
      return request.auth != null && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('linkedPartnerId', null) == userId;
    }

    match /users/{userId} {
      allow list: if request.auth != null;
      // Lectura completa: propio, admin, o pareja vinculada
      allow get: if request.auth != null && (request.auth.uid == userId || isAdmin() || isLinkedPartner(userId));

      // Escritura: propio, admin, o actualizar solo campos de vinculación en doc ajeno
      allow write: if request.auth != null && (
        request.auth.uid == userId 
        || isAdmin()
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['linkedPartnerId', 'linkedPartners'])
        )
      );

      match /{allSubcollections=**} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin() || isLinkedPartner(userId));
        allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }
    }


    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}